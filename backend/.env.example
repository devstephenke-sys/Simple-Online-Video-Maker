# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://simple-online-video-maker.vercel.app

# File Storage
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
OUTPUT_DIR=./output
MAX_UPLOAD_SIZE=524288000
MAX_PROJECT_FILES=50

# Media Processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_RENDER_JOBS=3
RENDER_TIMEOUT=600

# File Retention (in seconds)
TEMP_FILE_RETENTION=3600
OUTPUT_FILE_RETENTION=86400
